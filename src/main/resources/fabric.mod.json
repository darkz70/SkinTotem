{
  "schemaVersion": 1,
  "id": "skintotem",
  "version": "${version}",
  "name": "Skin Totem",
  "description": "Replaces the Totem of Undying texture with a mini-player figure based on the player's nickname.",
  "authors": [
    "Darkz"
  ],
  "contact": {
    "repo": "https://github.com/darkz70/SkinTotem"
  },
  "license": "MIT",
  "icon": "assets/skintotem/icon.png",
  "environment": "*",

  "entrypoints": {
  "client": [
    "spichka.skintotem.client.SkinTotemClient"
  ],
  "main": [
    "spichka.skintotem.SkinTotem"
  ]
  }

  "mixins": [
    "skintotem.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
