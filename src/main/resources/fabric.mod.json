{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"issues": "https://github.com/${github_mod_author}/${mod_id}/issues"
	},
	"license": "${mod_license}",
	"icon": "icon/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.darkz.skintotem.entrypoint.CommonEntrypoint"
		],
		"client": [
			"com.darkz.skintotem.entrypoint.ClientEntrypoint"
		],
		"modmenu": [
			"com.darkz.skintotem.modmenu.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": ">=${minecraft}",
		"java": ">=${java}",
		"${fabric_api_id}": "*"
	},
	"accessWidener": "${fabric_trick_accesswidener_id}",
	"mixins": [
		"${fabric_trick_mixin_configs}"
	]
}