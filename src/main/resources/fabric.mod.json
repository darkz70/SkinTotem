{
  "schemaVersion": 1,
  "id": "skintotem",
  "version": "2.0.0",
  "name": "SkinTotem",
  "description": "Replace Totem of Undying texture with a player skin. Use /totem <nick|url> or rename the totem on an anvil.",
  "authors": ["Darkz"],
  "contact": {
    "sources": "https://github.com/darkz70/SkinTotem"
  },
  "license": "MIT",
  "icon": "assets/skintotem/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.darkz.skintotem.SkinTotemMod"],
    "client": ["com.darkz.skintotem.SkinTotemClient"]
  },
  "mixins": [
    "skintotem.mixins.json",
    {
      "config": "skintotem.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
